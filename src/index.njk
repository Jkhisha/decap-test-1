---
layout: base.njk
title: Home
---
<h1>{{ site.title }}</h1>
<p class="lead">{{ site.description }}</p>

<h2>Posts</h2>
<ul class="post-list">
{%- for post in collections.post | reverse %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <span class="post-date">{{ post.date | date }}</span>
  </li>
{%- endfor %}
</ul>
